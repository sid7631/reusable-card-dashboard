# Copy to .env for local development (values below match infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/spendboard
WAREHOUSE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/demo_warehouse
DEMO_WAREHOUSE_HOST=localhost
DEMO_WAREHOUSE_PORT=5433
DEMO_WAREHOUSE_PASSWORD=reader
REDIS_URL=redis://localhost:6380/0
JWKS_URL=http://localhost:3001/auth/.well-known/jwks.json
# Local dev: let analysts connect to localhost sources (keep false in shared environments)
ALLOW_PRIVATE_NETWORK_SOURCES=true
SECRET_KEY=nuq76J6YCJWJcPJO6xKSSOxGiTLTXSWS6pGnCZ2ZZAM=

# Dashboard assistant (OpenAI chat-completions format). Default: offline — no model calls.
# LLM_PROVIDER=offline
#
# Ollama (local test) — any tool-calling model, e.g. `ollama pull qwen2.5:7b`
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
#
# Azure OpenAI (production) — LLM_MODEL is the deployment name
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# LLM_API_KEY=<key>
# LLM_MODEL=<deployment>

# BigQuery: real projects need no setting here (each source carries its own service-account key).
# Development only — send every BigQuery source to the local emulator (started by `npm run infra`;
# the seed loads the demo data into it and adds the "BigQuery Demo" dashboard):
BIGQUERY_EMULATOR_HOST=http://localhost:9050

# Where workers fetch the demo REST source ("Merchant Partner Program") from — this API's /demo endpoint
# DEMO_API_BASE_URL=http://localhost:8010

# File storage: "local" (STORAGE_DIR shared by API and workers) or "s3"
# STORAGE_BACKEND=local
# STORAGE_DIR=storage
# S3_BUCKET=
# S3_PREFIX=spendboard
# S3_ENDPOINT_URL=          # MinIO / R2; leave empty for AWS
# S3_REGION=

# Job queue broker (defaults to REDIS_URL); e.g. amqp://user:pass@rabbitmq:5672//
# CELERY_BROKER_URL=
